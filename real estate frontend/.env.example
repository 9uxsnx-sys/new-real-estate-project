# Copy this file to .env and update values as needed

# Payload CMS backend - set this for production deployments
# In development, Vite proxy handles /api requests automatically
# VITE_API_URL=https://your-production-api.com

# Dev: run `npm run dev` in this folder — Vite serves the SPA on http://localhost:5173

# Optional: Analytics, Maps API keys, etc.
# VITE_GOOGLE_MAPS_API_KEY=your_key_here
