# Copy to .env and adjust values.

DATABASE_URL=postgresql://payload_user:payload_pass123@localhost:5432/payload_db
PAYLOAD_SECRET=replace-with-at-least-32-characters

# Payload admin + REST (Next.js dev server)
SERVER_URL=http://localhost:3000

# Vite dev server origin — required for browser CORS from the React app
FRONTEND_URL=http://localhost:5173

# Optional
NEXT_TURBOPACK=0
